{
  "name": "question-generator",
  "packageManager": "pnpm@10.11.1",
  "private": true,
  "engines": {
    "node": "22.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "dev:backend": "pnpm --filter @veda/backend dev",
    "dev:worker": "pnpm --filter @veda/worker dev",
    "dev:all": "pnpm --parallel --filter @veda/backend --filter @veda/worker run dev",
    "build": "pnpm --filter @veda/shared build && pnpm --filter @veda/backend build && pnpm --filter @veda/worker build",
    "start:backend": "pnpm --filter @veda/backend start",
    "start:worker": "pnpm --filter @veda/worker start",
    "start:combined": "concurrently -n backend,worker -c cyan,yellow \"pnpm start:backend\" \"pnpm start:worker\""
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
